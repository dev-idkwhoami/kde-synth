# Generated by scripts/build-arch-package.sh from a checksummed local source archive.
pkgname=kde-synth
pkgver='@PACKAGE_VERSION@'
pkgrel=1
pkgdesc='Music visualizer above your wallpaper and below your Plasma windows'
arch=('x86_64')
url='@PROJECT_URL@'
license=('@LICENSE@')
depends=('gcc-libs' 'glibc' 'qt6-base' 'qt6-declarative' 'layer-shell-qt' 'pipewire' 'pipewire-audio' 'kwin')
makedepends=('cmake' 'ninja' 'go' 'qt6-shadertools')
checkdepends=('desktop-file-utils')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cmake -S "$pkgname-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib -DBUILD_TESTING=ON
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
    (cd "$pkgname-$pkgver" && GOCACHE="$srcdir/build/go-cache" go test ./audio)
    desktop-file-validate "$pkgname-$pkgver/packaging/dev.kdesynth.Visualizer.desktop"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
